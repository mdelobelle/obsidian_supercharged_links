{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "lib": [
      "dom",
      "es2018",
      "scripthost",
      "es2020"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
